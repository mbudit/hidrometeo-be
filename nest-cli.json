{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/aadts",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/aadts/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "aadts": {
      "type": "application",
      "root": "apps/aadts",
      "entryFile": "main",
      "sourceRoot": "apps/aadts/src",
      "compilerOptions": {
        "tsConfigPath": "apps/aadts/tsconfig.app.json"
      }
    },
    "apms": {
      "type": "application",
      "root": "apps/apms",
