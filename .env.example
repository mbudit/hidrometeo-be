# ── Docker ────────────────────────────────
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hidrometeorology

# ── Database ──────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hidrometeorology
DATABASE_USER=hidro_user
DATABASE_PASSWORD=your_secure_password

# ── JWT ───────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── EMQX MQTT ─────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=hidro_backend
MQTT_PASSWORD=your_mqtt_password

# ── App Ports ─────────────────────────────
AADTS_PORT=3001
APMS_PORT=3002
SAMS_PORT=3003
MVMS_PORT=3004
ADSBMAS_PORT=3005
WSDAS_PORT=3006
VIMS_PORT=3007
MDPS_PORT=3008

# ── Internal API URLs (untuk consumer app) ─
APMS_INTERNAL_URL=http://app-apms:3002
MVMS_INTERNAL_URL=http://app-mvms:3004

# ── ADS-B Receiver ────────────────────────
ADSB_HOST=localhost
ADSB_PORT=30002

# ── Prometheus & Grafana ──────────────────
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_grafana_token

# ── MediaMTX ──────────────────────────────
MEDIAMTX_URL=http://mediamtx:9997
MEDIAMTX_API_KEY=your_mediamtx_key
